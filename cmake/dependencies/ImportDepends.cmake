if(NOT IS_DIRECTORY "${KMD_DEPENDS_PREFIX}/include")
  message(FATAL_ERROR "KMD_DEPENDS_PREFIX must point to a completed isolated depends installation. Build the outer project's depends target first.")
endif()
file(REAL_PATH "${KMD_DEPENDS_PREFIX}" KMD_DEPENDS_PREFIX)
file(REAL_PATH "${KMD_REPOSITORY}/depends" legacy_depends)
string(FIND "${KMD_DEPENDS_PREFIX}/" "${legacy_depends}/" legacy_index)
if(legacy_index EQUAL 0)
  message(FATAL_ERROR "Refusing to mix CMake and legacy depends binaries")
endif()
find_package(Threads REQUIRED)
find_program(PKG_CONFIG_EXECUTABLE pkg-config REQUIRED)
# Restrict pkg-config to this prefix, including all transitive requirements.
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${KMD_DEPENDS_PREFIX}/lib/pkgconfig:${KMD_DEPENDS_PREFIX}/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "")

function(kmd_import name archive)
  set(path "${KMD_DEPENDS_PREFIX}/lib/lib${archive}.a")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing isolated dependency: ${path}")
  endif()
  add_library(dep_${name} STATIC IMPORTED GLOBAL)
  set_target_properties(dep_${name} PROPERTIES IMPORTED_LOCATION "${path}"
    INTERFACE_INCLUDE_DIRECTORIES "${KMD_DEPENDS_PREFIX}/include")
endfunction()
foreach(lib boost_system boost_filesystem boost_thread boost_chrono boost_program_options
    ssl crypto event event_pthreads sodium curl rustzcash)
  kmd_import(${lib} ${lib})
endforeach()
kmd_import(bdb db_cxx-6.2)
file(STRINGS "${KMD_DEPENDS_PREFIX}/include/db.h" bdb_version REGEX "^#define[ \t]+DB_VERSION_(MAJOR|MINOR)[ \t]+")
if(NOT bdb_version MATCHES "DB_VERSION_MAJOR[ \t]+6" OR NOT bdb_version MATCHES "DB_VERSION_MINOR[ \t]+2")
  message(FATAL_ERROR "Wallet compatibility requires Berkeley DB 6.2")
endif()
if(KMD_ENABLE_ZMQ)
  kmd_import(zmq zmq)
endif()
if(KMD_BUILD_TESTS)
  kmd_import(gtest gtest)
endif()
add_library(kmd_dependencies INTERFACE)
target_link_libraries(kmd_dependencies INTERFACE dep_boost_system dep_boost_filesystem dep_boost_thread
  dep_boost_chrono dep_boost_program_options dep_curl dep_ssl dep_crypto dep_event_pthreads dep_event
  dep_bdb dep_sodium dep_rustzcash Threads::Threads ${CMAKE_DL_LIBS} m)
# curl's existing recipe may use the platform zlib. Query the recipe's installed
# metadata rather than guessing its optional link dependencies.
execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --static --libs libcurl
  OUTPUT_VARIABLE curl_link_line OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
separate_arguments(curl_link_flags UNIX_COMMAND "${curl_link_line}")
foreach(flag IN LISTS curl_link_flags)
  if(flag MATCHES "^-l(.+)")
    set(lib "${CMAKE_MATCH_1}")
    if(lib MATCHES "^(curl|ssl|crypto)$")
      continue()
    endif()
    if(EXISTS "${KMD_DEPENDS_PREFIX}/lib/lib${lib}.a")
      target_link_libraries(kmd_dependencies INTERFACE "${KMD_DEPENDS_PREFIX}/lib/lib${lib}.a")
    elseif(lib MATCHES "^(z|dl|pthread|m|rt)$")
      target_link_libraries(kmd_dependencies INTERFACE "${lib}")
    else()
      message(FATAL_ERROR "Unmanaged curl dependency '${lib}'. Rebuild depends in a controlled environment.")
    endif()
  endif()
endforeach()
if(KMD_ENABLE_ZMQ)
  target_link_libraries(kmd_dependencies INTERFACE dep_zmq)
endif()
