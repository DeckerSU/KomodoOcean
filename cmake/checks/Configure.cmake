include(CheckIncludeFile)
include(CheckSymbolExists)
include(CheckCSourceCompiles)
include(CheckCXXSourceCompiles)
include(CheckCXXCompilerFlag)
include(CheckLinkerFlag)
include(TestBigEndian)
set(CMAKE_REQUIRED_INCLUDES "${KMD_DEPENDS_PREFIX}/include")
foreach(header endian.h sys/endian.h byteswap.h stdio.h stdlib.h unistd.h strings.h
    string.h sys/types.h sys/stat.h sys/select.h sys/prctl.h dlfcn.h inttypes.h memory.h stdint.h
    alloca.h arpa/inet.h float.h limits.h locale.h malloc.h netinet/in.h stdbool.h)
  string(TOUPPER "${header}" key)
  string(REGEX REPLACE "[/.]" "_" key "${key}")
  check_include_file("${header}" HAVE_${key})
endforeach()
foreach(symbol le16toh le32toh le64toh htole16 htole32 htole64 be16toh be32toh be64toh htobe16 htobe32 htobe64)
  string(TOUPPER "${symbol}" key)
  check_symbol_exists(${symbol} endian.h HAVE_DECL_${key})
endforeach()
foreach(symbol bswap_16 bswap_32 bswap_64)
  string(TOUPPER "${symbol}" key)
  check_symbol_exists(${symbol} byteswap.h HAVE_DECL_${key})
endforeach()
check_symbol_exists(strnlen string.h HAVE_DECL_STRNLEN)
check_symbol_exists(strerror_r string.h HAVE_DECL_STRERROR_R)
set(HAVE_STRERROR_R ${HAVE_DECL_STRERROR_R})
check_symbol_exists(inet_pton arpa/inet.h HAVE_INET_PTON)
check_symbol_exists(MSG_NOSIGNAL sys/socket.h HAVE_MSG_NOSIGNAL)
check_symbol_exists(PTHREAD_PRIO_INHERIT pthread.h HAVE_PTHREAD_PRIO_INHERIT)
set(CMAKE_REQUIRED_LIBRARIES dep_crypto)
check_symbol_exists(EVP_MD_CTX_new openssl/evp.h HAVE_DECL_EVP_MD_CTX_NEW)
unset(CMAKE_REQUIRED_LIBRARIES)
set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
check_symbol_exists(getaddrinfo_a netdb.h HAVE_GETADDRINFO_A)
if(NOT HAVE_GETADDRINFO_A)
  set(CMAKE_REQUIRED_LIBRARIES anl)
  check_symbol_exists(getaddrinfo_a netdb.h HAVE_GETADDRINFO_A_WITH_ANL)
  if(HAVE_GETADDRINFO_A_WITH_ANL)
    set(HAVE_GETADDRINFO_A 1)
    target_link_libraries(kmd_dependencies INTERFACE anl)
  endif()
endif()
unset(CMAKE_REQUIRED_LIBRARIES)
check_cxx_source_compiles("#include <string.h>\nint main(){char b[32]; char* p=strerror_r(0,b,sizeof(b)); return !p;}" STRERROR_R_CHAR_P)
unset(CMAKE_REQUIRED_DEFINITIONS)
check_c_source_compiles("int main(){__int128 x=1; return (int)x;}" HAVE___INT128)
check_c_source_compiles("int main(){return __builtin_expect(0,0);}" HAVE_BUILTIN_EXPECT)
check_c_source_compiles("__attribute__((visibility(\"default\"))) void f(void){}\nint main(){f();}" HAVE_FUNC_ATTRIBUTE_VISIBILITY)
set(HAVE_VISIBILITY_ATTRIBUTE ${HAVE_FUNC_ATTRIBUTE_VISIBILITY})
test_big_endian(WORDS_BIGENDIAN)
set(ENABLE_WALLET 1)
set(ENABLE_RUST 1)
set(ENABLE_MINING ${KMD_ENABLE_MINING})
set(ENABLE_ZMQ ${KMD_ENABLE_ZMQ})
set(HAVE_CONSENSUS_LIB ${KMD_BUILD_CONSENSUS})
set(USE_QRCODE ${KMD_BUILD_GUI})
set(QT_STATICPLUGIN ${KMD_BUILD_GUI})
set(QT_QPA_PLATFORM_XCB ${KMD_BUILD_GUI})
set(QT_QPA_PLATFORM_MINIMAL ${KMD_BUILD_GUI})
set(HAVE_PTHREAD 1)
set(STDC_HEADERS 1)
set(HAVE_WORKING_BOOST_SLEEP_FOR 1)
foreach(component BOOST BOOST_CHRONO BOOST_FILESYSTEM BOOST_PROGRAM_OPTIONS BOOST_SYSTEM BOOST_THREAD)
  set(HAVE_${component} 1)
endforeach()
if(KMD_ENABLE_ASM)
  check_cxx_compiler_flag(-msse4.1 ENABLE_SSE41)
  check_cxx_compiler_flag(-msse4.2 ENABLE_SSE42)
  check_cxx_compiler_flag("-mavx -mavx2" ENABLE_AVX2)
  check_cxx_compiler_flag("-msse4 -msha" ENABLE_SHANI)
  set(USE_ASM 1)
else()
  foreach(feature SSE41 SSE42 AVX2 SHANI)
    set(ENABLE_${feature} 0)
  endforeach()
  set(USE_ASM 0)
endif()
# Read only the version constants: configure.ac remains the version authority.
file(STRINGS "${KMD_REPOSITORY}/configure.ac" version_lines REGEX "^define\\(_(CLIENT_VERSION_|COPYRIGHT_)")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KMD_REPOSITORY}/configure.ac")
foreach(line IN LISTS version_lines)
  if(line MATCHES "^define\\(_([A-Z_]+), (.*)\\)$")
    set(${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
  endif()
endforeach()
set(PACKAGE_VERSION "${CLIENT_VERSION_MAJOR}.${CLIENT_VERSION_MINOR}.${CLIENT_VERSION_REVISION}")
if(CLIENT_VERSION_BUILD LESS 25)
  math(EXPR suffix "${CLIENT_VERSION_BUILD}+1")
  string(APPEND PACKAGE_VERSION "-beta${suffix}")
elseif(CLIENT_VERSION_BUILD LESS 50)
  math(EXPR suffix "${CLIENT_VERSION_BUILD}-24")
  string(APPEND PACKAGE_VERSION "-rc${suffix}")
elseif(CLIENT_VERSION_BUILD GREATER 50)
  math(EXPR suffix "${CLIENT_VERSION_BUILD}-50")
  string(APPEND PACKAGE_VERSION "-${suffix}")
endif()
configure_file("${KMD_CMAKE_DIR}/templates/bitcoin-config.h.in" "${SRC}/config/bitcoin-config.h")
add_library(kmd_options INTERFACE)
target_include_directories(kmd_options INTERFACE "${SRC}" "${SRC}/config" "${SRC}/obj"
  "${SRC}/secp256k1/include" "${SRC}/univalue/include" "${SRC}/cryptoconditions/include"
  "${SRC}/cryptoconditions/src" "${SRC}/cryptoconditions/src/asn" "${SRC}/cc/includes"
  "${SRC}/leveldb/include" "${SRC}/leveldb/helpers/memenv")
target_compile_definitions(kmd_options INTERFACE HAVE_CONFIG_H HAVE_BUILD_INFO __STDC_FORMAT_MACROS
  _HAS_AUTO_PTR_ETC=0 BOOST_NO_CXX98_FUNCTION_BASE "$<$<CONFIG:Debug>:DEBUG;DEBUG_LOCKORDER>")
target_compile_options(kmd_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:-fwrapv;-fno-strict-aliasing>")
if(KMD_HARDENING)
  check_cxx_compiler_flag(-fstack-protector-all KMD_HAS_STACK_PROTECTOR)
  check_linker_flag(CXX -pie KMD_HAS_PIE)
  if(NOT KMD_HAS_STACK_PROTECTOR OR NOT KMD_HAS_PIE)
    message(FATAL_ERROR "Requested hardening is not supported by this compiler")
  endif()
  target_compile_options(kmd_options INTERFACE -fstack-protector-all -Wformat -Wformat-security
    "$<$<NOT:$<CONFIG:Debug>>:-U_FORTIFY_SOURCE;-D_FORTIFY_SOURCE=2>")
  target_link_options(kmd_options INTERFACE -pie)
endif()
file(MAKE_DIRECTORY "${SRC}/obj")
add_custom_target(build_info
  COMMAND sh "${KMD_REPOSITORY}/share/genbuild.sh" "${SRC}/obj/build.h" "${KMD_REPOSITORY}"
  BYPRODUCTS "${SRC}/obj/build.h" VERBATIM)
