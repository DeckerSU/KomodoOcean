# Copy only reviewed inputs, never generated headers, binaries or local experiments.
# configure_file(COPYONLY) also registers inputs for automatic reconfiguration.
function(kmd_snapshot manifest destination)
  file(STRINGS "${manifest}" inputs)
  set(previous_manifest "${destination}/.kmd-snapshot-inputs")
  if(EXISTS "${previous_manifest}")
    file(STRINGS "${previous_manifest}" previous_inputs)
    foreach(input IN LISTS previous_inputs)
      if(IS_ABSOLUTE "${input}" OR input MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid previous snapshot input: ${input}")
      endif()
      if(NOT input IN_LIST inputs)
        file(REMOVE "${destination}/${input}")
      endif()
    endforeach()
  endif()
  foreach(input IN LISTS inputs)
    if(IS_ABSOLUTE "${input}" OR input MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Invalid snapshot input: ${input}")
    endif()
    configure_file("${KMD_REPOSITORY}/${input}" "${destination}/${input}" COPYONLY)
  endforeach()
  configure_file("${manifest}" "${previous_manifest}" COPYONLY)
endfunction()
