option(KMD_BUILD_GUI "Build the Qt5 wallet" ON)
option(KMD_BUILD_TESTS "Build komodo-test and register it with CTest" OFF)
option(KMD_BUILD_CONSENSUS "Build the static consensus library" ON)
option(KMD_ENABLE_MINING "Enable mining" ON)
option(KMD_ENABLE_ZMQ "Enable ZMQ notifications" ON)
option(KMD_ENABLE_ASM "Enable supported x86 acceleration" ON)
option(KMD_HARDENING "Enable stack protection and PIE" ON)
set(KMD_DEPENDS_PREFIX "" CACHE PATH "Use an existing, separate depends prefix (read-only)")
set(KMD_JOBS "4" CACHE STRING "Parallel jobs for depends and the nested application build")
if(NOT KMD_JOBS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "KMD_JOBS must be a positive integer")
endif()
if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
if(NOT CMAKE_BUILD_TYPE MATCHES "^(Release|Debug|RelWithDebInfo|MinSizeRel)$")
  message(FATAL_ERROR "Use a single Release, Debug, RelWithDebInfo or MinSizeRel configuration")
endif()
