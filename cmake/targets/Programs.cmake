function(kmd_program name source)
  add_executable(${name} "${SRC}/${source}")
  # The existing core archives have circular references. Keep group rescanning
  # local to final executables, not a global linker flag.
  target_link_libraries(${name} PRIVATE kmd_options "-Wl,--start-group" ${KMD_CORE_LIBRARIES}
    kmd_dependencies "-Wl,--end-group")
  install(TARGETS ${name} RUNTIME DESTINATION bin)
endfunction()
kmd_program(komodod bitcoind.cpp)
kmd_program(komodo-cli bitcoin-cli.cpp)
kmd_program(komodo-tx komodo-tx.cpp)
kmd_program(wallet-utility wallet-utility.cpp)
add_executable(fetch-params "${SRC}/fetch-params.cpp")
target_link_libraries(fetch-params PRIVATE kmd_options kmd_dependencies)
install(TARGETS fetch-params RUNTIME DESTINATION bin)
if(KMD_BUILD_CONSENSUS)
  kmd_library(zcashconsensus libzcashconsensus_la_SOURCES)
  target_compile_definitions(zcashconsensus PRIVATE BUILD_BITCOIN_INTERNAL)
  target_compile_options(zcashconsensus PRIVATE -fvisibility=hidden)
  target_link_libraries(zcashconsensus PRIVATE secp256k1)
  install(TARGETS zcashconsensus ARCHIVE DESTINATION lib)
  install(FILES "${SRC}/script/zcashconsensus.h" DESTINATION include)
endif()
install(PROGRAMS "${KMD_REPOSITORY}/zcutil/fetch-params.sh" DESTINATION bin RENAME zcash-fetch-params)
if(KMD_BUILD_TESTS)
  enable_testing()
  set(test_sources ${komodo_test_SOURCES})
  list(TRANSFORM test_sources PREPEND "${SRC}/")
  add_executable(komodo-test ${test_sources})
  target_link_libraries(komodo-test PRIVATE kmd_options dep_gtest "-Wl,--start-group"
    ${KMD_CORE_LIBRARIES} kmd_dependencies "-Wl,--end-group")
  add_test(NAME komodo-test COMMAND komodo-test)
  set_tests_properties(komodo-test PROPERTIES WORKING_DIRECTORY "${SRC}" TIMEOUT 600)
endif()
