# depends deliberately removes Qt's CMake package files. Consume its static
# pkg-config metadata and host tools without searching the system Qt install.
set(qt_modules Qt5Core Qt5Gui Qt5Widgets Qt5Network Qt5DBus Qt5AccessibilitySupport
  Qt5DeviceDiscoverySupport Qt5EdidSupport Qt5EventDispatcherSupport Qt5FbSupport
  Qt5FontDatabaseSupport Qt5ThemeSupport Qt5InputSupport Qt5ServiceSupport Qt5XcbQpa Qt5XkbCommonSupport)
execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --static --libs ${qt_modules}
  OUTPUT_VARIABLE qt_link_line OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --cflags Qt5Core Qt5Gui Qt5Widgets Qt5Network Qt5DBus
  OUTPUT_VARIABLE qt_compile_line OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
separate_arguments(qt_link_flags UNIX_COMMAND "${qt_link_line}")
separate_arguments(qt_compile_flags UNIX_COMMAND "${qt_compile_line}")
set(qt_libraries)
foreach(flag IN LISTS qt_link_flags)
  if(flag MATCHES "^-L")
    continue()
  elseif(flag MATCHES "^-l(.+)")
    set(lib "${CMAKE_MATCH_1}")
    if(lib MATCHES "^(m|dl|pthread|rt|resolv)$")
      list(APPEND qt_libraries "${flag}")
    elseif(EXISTS "${KMD_DEPENDS_PREFIX}/lib/lib${lib}.a")
      list(APPEND qt_libraries "${KMD_DEPENDS_PREFIX}/lib/lib${lib}.a")
    elseif(EXISTS "${KMD_DEPENDS_PREFIX}/lib/lib${lib}.so")
      # The current recipes intentionally build parts of XCB as shared libraries.
      list(APPEND qt_libraries "${KMD_DEPENDS_PREFIX}/lib/lib${lib}.so")
    else()
      message(FATAL_ERROR "Missing Qt dependency ${lib} in ${KMD_DEPENDS_PREFIX}")
    endif()
  elseif(IS_ABSOLUTE "${flag}")
    string(FIND "${flag}" "${KMD_DEPENDS_PREFIX}/" prefix_index)
    if(NOT prefix_index EQUAL 0 OR NOT EXISTS "${flag}")
      message(FATAL_ERROR "Qt metadata refers outside its prefix: ${flag}. Rebuild depends at this location.")
    endif()
    list(APPEND qt_libraries "${flag}")
  else()
    list(APPEND qt_libraries "${flag}")
  endif()
endforeach()
foreach(tool moc uic rcc lrelease)
  set(qt_${tool} "${KMD_DEPENDS_PREFIX}/native/bin/${tool}")
  if(NOT EXISTS "${qt_${tool}}")
    message(FATAL_ERROR "Missing Qt host tool: ${qt_${tool}}")
  endif()
endforeach()
foreach(plugin qxcb qminimal)
  set(plugin_file "${KMD_DEPENDS_PREFIX}/plugins/platforms/lib${plugin}.a")
  if(NOT EXISTS "${plugin_file}")
    message(FATAL_ERROR "Missing Qt platform plugin: ${plugin_file}")
  endif()
  list(PREPEND qt_libraries "${plugin_file}")
endforeach()
kmd_import(qrencode qrencode)
set(qt_generated)
foreach(form IN LISTS QT_FORMS_UI)
  get_filename_component(stem "${form}" NAME_WE)
  set(output "${SRC}/qt/forms/ui_${stem}.h")
  add_custom_command(OUTPUT "${output}" COMMAND "${qt_uic}" -o "${output}" "${SRC}/${form}"
    DEPENDS "${SRC}/${form}" "${qt_uic}" VERBATIM)
  list(APPEND qt_generated "${output}")
endforeach()
set(moc_flags ${qt_compile_flags} -DHAVE_CONFIG_H -DQT_NO_KEYWORDS "-I${SRC}" "-I${SRC}/qt"
  "-I${SRC}/qt/forms" "-I${KMD_DEPENDS_PREFIX}/include")
foreach(output IN LISTS QT_MOC_CPP QT_MOC)
  if(output MATCHES "qt/moc_(.*)\\.cpp$")
    set(input "qt/${CMAKE_MATCH_1}.h")
  else()
    string(REPLACE ".moc" ".cpp" input "${output}")
  endif()
  if(NOT EXISTS "${SRC}/${input}")
    message(FATAL_ERROR "Missing moc input: ${input}")
  endif()
  add_custom_command(OUTPUT "${SRC}/${output}"
    COMMAND "${qt_moc}" ${moc_flags} -o "${SRC}/${output}" "${SRC}/${input}"
    DEPENDS "${SRC}/${input}" "${SRC}/config/bitcoin-config.h" "${qt_moc}" VERBATIM)
  list(APPEND qt_generated "${SRC}/${output}")
endforeach()
set(qm_files)
foreach(ts IN LISTS QT_TS)
  string(REPLACE ".ts" ".qm" qm "${ts}")
  add_custom_command(OUTPUT "${SRC}/${qm}"
    COMMAND "${qt_lrelease}" -silent "${SRC}/${ts}" -qm "${SRC}/${qm}"
    DEPENDS "${SRC}/${ts}" "${qt_lrelease}" VERBATIM)
  list(APPEND qm_files "${SRC}/${qm}")
endforeach()
foreach(resource komodo komodo_locale)
  file(STRINGS "${SRC}/qt/${resource}.qrc" resource_lines REGEX "<file")
  set(resource_files)
  foreach(line IN LISTS resource_lines)
    if(line MATCHES "<file[^>]*>([^<]+)</file>")
      list(APPEND resource_files "${SRC}/qt/${CMAKE_MATCH_1}")
    endif()
  endforeach()
  add_custom_command(OUTPUT "${SRC}/qt/qrc_${resource}.cpp"
    COMMAND "${qt_rcc}" -name "${resource}" -o "${SRC}/qt/qrc_${resource}.cpp" "${SRC}/qt/${resource}.qrc"
    DEPENDS "${SRC}/qt/${resource}.qrc" ${resource_files} "${qt_rcc}" VERBATIM)
  list(APPEND qt_generated "${SRC}/qt/qrc_${resource}.cpp")
endforeach()
add_custom_target(qt_generated DEPENDS ${qt_generated} ${qm_files})
set(qt_sources ${KOMODO_QT_BASE_CPP} ${KOMODO_QT_WALLET_CPP}
  policy/policy.cpp wallet/rpcwallet.cpp rpc/server.cpp)
list(TRANSFORM qt_sources PREPEND "${SRC}/")
add_library(komodoqt STATIC ${qt_sources} ${qt_generated})
add_dependencies(komodoqt qt_generated)
target_link_libraries(komodoqt PUBLIC kmd_options kmd_dependencies dep_qrencode)
target_compile_options(komodoqt PUBLIC ${qt_compile_flags})
target_compile_definitions(komodoqt PUBLIC QT_NO_KEYWORDS)
target_include_directories(komodoqt PUBLIC "${SRC}/qt" "${SRC}/qt/forms")
add_executable(komodo-qt "${SRC}/qt/komodoapp.cpp" "${KMD_CMAKE_DIR}/targets/qt_plugins.cpp")
add_dependencies(komodo-qt qt_generated)
target_link_libraries(komodo-qt PRIVATE "-Wl,--start-group" bitcoin_server komodoqt
  ${KMD_CORE_LIBRARIES} kmd_dependencies ${qt_libraries} "-Wl,--end-group")
# Use an inherited ELF RPATH for the transitive shared XCB dependencies too.
target_link_options(komodo-qt PRIVATE -Wl,--disable-new-dtags)
set_target_properties(komodo-qt PROPERTIES BUILD_RPATH "${KMD_DEPENDS_PREFIX}/lib"
  INSTALL_RPATH "$ORIGIN/../lib/komodoocean")
install(TARGETS komodo-qt RUNTIME DESTINATION bin)
install(DIRECTORY "${KMD_DEPENDS_PREFIX}/lib/" DESTINATION lib/komodoocean
  FILES_MATCHING PATTERN "*.so*" PATTERN "pkgconfig" EXCLUDE PATTERN "cmake" EXCLUDE)
