function(kmd_library target list_name)
  set(files ${${list_name}})
  list(TRANSFORM files PREPEND "${SRC}/")
  add_library(${target} STATIC ${files})
  target_link_libraries(${target} PUBLIC kmd_options kmd_dependencies)
endfunction()

if(HAVE___INT128)
  set(USE_FIELD_5X52 1)
  set(USE_SCALAR_4X64 1)
else()
  set(USE_FIELD_10X26 1)
  set(USE_SCALAR_8X32 1)
endif()
set(USE_ASM_X86_64 ${KMD_ENABLE_ASM})
configure_file("${KMD_CMAKE_DIR}/templates/secp256k1-config.h.in" "${SRC}/secp256k1/src/libsecp256k1-config.h")
add_executable(secp256k1_gen_context EXCLUDE_FROM_ALL "${SRC}/secp256k1/src/gen_context.c")
target_include_directories(secp256k1_gen_context PRIVATE "${SRC}/secp256k1")
set_target_properties(secp256k1_gen_context PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/native")
add_custom_command(OUTPUT "${SRC}/secp256k1/src/ecmult_static_context.h"
  COMMAND secp256k1_gen_context WORKING_DIRECTORY "${SRC}/secp256k1"
  DEPENDS secp256k1_gen_context VERBATIM)
add_library(secp256k1 STATIC "${SRC}/secp256k1/src/secp256k1.c" "${SRC}/secp256k1/src/ecmult_static_context.h")
target_compile_definitions(secp256k1 PRIVATE HAVE_CONFIG_H SECP256K1_BUILD ENABLE_MODULE_MUSIG)
target_include_directories(secp256k1 PUBLIC "${SRC}/secp256k1/include" PRIVATE "${SRC}/secp256k1/src" "${SRC}/secp256k1")

add_library(univalue STATIC "${SRC}/univalue/lib/univalue.cpp" "${SRC}/univalue/lib/univalue_get.cpp"
  "${SRC}/univalue/lib/univalue_read.cpp" "${SRC}/univalue/lib/univalue_write.cpp")
target_include_directories(univalue PUBLIC "${SRC}/univalue/include")
set(cc_files ${libcryptoconditions_core_la_SOURCES})
list(TRANSFORM cc_files PREPEND "${SRC}/cryptoconditions/")
add_library(cryptoconditions STATIC ${cc_files})
target_include_directories(cryptoconditions PUBLIC "${SRC}/cryptoconditions/include" PRIVATE
  "${SRC}/cryptoconditions" "${SRC}/cryptoconditions/src/asn" "${SRC}/cryptoconditions/src/include")
target_link_libraries(cryptoconditions PUBLIC secp256k1)

kmd_library(leveldb leveldb_libleveldb_a_SOURCES)
target_include_directories(leveldb PRIVATE "${SRC}/leveldb")
target_compile_definitions(leveldb PRIVATE LEVELDB_PLATFORM_POSIX LEVELDB_ATOMIC_PRESENT __STDC_LIMIT_MACROS)
add_library(memenv STATIC "${SRC}/leveldb/helpers/memenv/memenv.cc")
target_include_directories(memenv PRIVATE "${SRC}/leveldb")
target_link_libraries(memenv PUBLIC leveldb)
add_library(leveldb_sse42 STATIC "${SRC}/leveldb/port/port_posix_sse.cc")
target_include_directories(leveldb_sse42 PRIVATE "${SRC}/leveldb")
target_link_libraries(leveldb_sse42 PUBLIC kmd_options)
foreach(target memenv leveldb_sse42)
  target_compile_definitions(${target} PRIVATE LEVELDB_PLATFORM_POSIX LEVELDB_ATOMIC_PRESENT __STDC_LIMIT_MACROS)
endforeach()
if(ENABLE_SSE42)
  target_compile_definitions(leveldb_sse42 PRIVATE LEVELDB_PLATFORM_POSIX_SSE)
  target_compile_options(leveldb_sse42 PRIVATE -msse4.2)
endif()

kmd_library(bitcoin_crypto crypto_libbitcoin_crypto_a_SOURCES)
if(USE_ASM)
  target_sources(bitcoin_crypto PRIVATE "${SRC}/crypto/sha256_sse4.cpp")
endif()
if(KMD_ENABLE_MINING)
  target_compile_definitions(bitcoin_crypto PRIVATE EQUIHASH_TROMP_ATOMIC)
endif()
foreach(feature SSE41 AVX2 SHANI)
  if(ENABLE_${feature})
    string(TOLOWER ${feature} suffix)
    add_library(crypto_${suffix} OBJECT "${SRC}/crypto/sha256_${suffix}.cpp")
    target_link_libraries(crypto_${suffix} PRIVATE kmd_options)
    target_compile_definitions(crypto_${suffix} PRIVATE ENABLE_${feature})
    if(feature STREQUAL "SSE41")
      target_compile_options(crypto_${suffix} PRIVATE -msse4.1)
    elseif(feature STREQUAL "AVX2")
      target_compile_options(crypto_${suffix} PRIVATE -mavx -mavx2)
    else()
      target_compile_options(crypto_${suffix} PRIVATE -msse4 -msha)
    endif()
    target_sources(bitcoin_crypto PRIVATE $<TARGET_OBJECTS:crypto_${suffix}>)
  endif()
endforeach()
foreach(component server wallet common util cli)
  kmd_library(bitcoin_${component} libbitcoin_${component}_a_SOURCES)
endforeach()
add_dependencies(bitcoin_util build_info)
target_compile_definitions(bitcoin_server PRIVATE BUILD_CUSTOMCC)
kmd_library(zcash libzcash_a_SOURCES)
target_compile_definitions(zcash PRIVATE BINARY_OUTPUT CURVE_ALT_BN128 BOOST_SPIRIT_THREADSAFE STATIC MONTGOMERY_OUTPUT)
target_compile_options(zcash PRIVATE -fvisibility=hidden)
add_library(cjson STATIC "${SRC}/cJSON.c" "${SRC}/komodo_cJSON.c")
set(KMD_CORE_LIBRARIES bitcoin_server bitcoin_wallet bitcoin_common univalue bitcoin_util bitcoin_cli
  bitcoin_crypto zcash leveldb leveldb_sse42 memenv secp256k1 cryptoconditions cjson)
if(KMD_ENABLE_ZMQ)
  kmd_library(bitcoin_zmq libbitcoin_zmq_a_SOURCES)
  list(APPEND KMD_CORE_LIBRARIES bitcoin_zmq)
endif()
